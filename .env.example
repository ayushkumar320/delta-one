# Copy to .env and fill in. Never commit .env.

# Postgres (run it with: docker run -d --name delta-postgres -p 5432:5432 \
#   -e POSTGRES_PASSWORD=postgres postgres:17)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# One database per service. Create them once with `make databases`.
AUTH_DB_NAME=delta_auth
CATALOG_DB_NAME=delta_catalog
BOOKING_DB_NAME=delta_booking
PAYMENT_DB_NAME=delta_payment

# Redis, used for the event stream and the gateway rate limiter (run it with:
#   docker run -d --name delta-redis -p 6379:6379 redis:8)
REDIS_ADDR=localhost:6379

# Auth. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Service ports
AUTH_PORT=8081
CATALOG_PORT=8082
BOOKING_PORT=8083
PAYMENT_PORT=8084
NOTIFICATION_PORT=8085
GATEWAY_PORT=8080

# Where each service can be reached, used by the gateway and by the booking
# service when it calls catalog and payment.
AUTH_URL=http://localhost:8081
CATALOG_URL=http://localhost:8082
BOOKING_URL=http://localhost:8083
PAYMENT_URL=http://localhost:8084

# The browser origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173
