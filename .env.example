# Copy to .env and fill in. Never commit .env.

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Auth
JWT_SECRET=

# Service ports
AUTH_PORT=8081
CATALOG_PORT=8082
BOOKING_PORT=8083
PAYMENT_PORT=8084
NOTIFICATION_PORT=8085
GATEWAY_PORT=8080
